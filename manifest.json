{
  "manifest_version": 3,
  "name": "Floating Selector Panel",
  "version": "1.0.0",
  "description": "Floating panel for selecting page elements and logging their text.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}